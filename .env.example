# Environment variable NAMES only. Never commit real values.
# Copy to .env.local and fill in locally. See docs/environment.md.

# Supabase project URL and publishable key (decision O4). Both are public and
# are sent to the browser. For local development, take them from
# `npm run db:status` (API URL and the publishable key); in production, from
# the hosted project's API settings (docs/deployment.md).
# The URL must be https:// (http:// only for a local stack); the server
# refuses to start otherwise (src/lib/env.ts).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Never add the service-role or secret key here, or in any NEXT_PUBLIC_
# variable: the app doesn't use it, and the build stops if a public variable
# holds one. The database tests (`npm run test:db`) read local keys from
# `supabase status` and need no variables.
