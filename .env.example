# Environment variable NAMES only. Never commit real values.
# Copy to .env.local and fill in locally.

# Supabase project URL and publishable key (decision O4). Both are public and
# are sent to the browser. For local development, take them from
# `npm run db:status` (API URL and the publishable key).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Never add the service-role or secret key here: the app doesn't use it.
# The database tests (`npm run test:db`) read local keys from `supabase status`
# and need no variables.
